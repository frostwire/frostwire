<!-- The tapped piece's details, over the Pieces tab's hive. Clickable so a tap on it doesn't reach
     the hive underneath. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/view_transfer_detail_piece_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_margin="8dp"
    android:background="@drawable/transfer_detail_piece_panel_background"
    android:clickable="true"
    android:elevation="4dp"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="8dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/view_transfer_detail_piece_panel_title"
            style="@style/transferDetailTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/view_transfer_detail_piece_panel_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/transfer_detail_piece_close"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/app_text_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/view_transfer_detail_piece_panel_details"
        style="@style/transferDetailText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingEnd="8dp"
        android:textIsSelectable="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/view_transfer_detail_piece_panel_priority_label"
            style="@style/transferDetailText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/transfer_detail_piece_priority"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/view_transfer_detail_piece_panel_priority"
            style="@style/transferDetailText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="8dp" />

        <Spinner
            android:id="@+id/view_transfer_detail_piece_panel_priority_choices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/transfer_detail_piece_priority"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
