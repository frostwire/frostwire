<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/view_public_catalog_wizard_page_title"
            style="@style/WizardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/icebridge_public_catalog_wizard_title" />

        <TextView
            style="@style/WizardDivider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/view_public_catalog_wizard_page_description"
            style="@style/WizardText.Sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/icebridge_public_catalog_wizard_description" />

        <CheckBox
            android:id="@+id/view_public_catalog_wizard_page_check_public_catalog"
            style="@style/WizardSubTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="16dp"
            android:text="@string/icebridge_public_catalog_wizard_label" />

    </LinearLayout>
</ScrollView>
